{
  "name": "ai-studio-multi-tool",
  "version": "1.0.0",
  "description": "Visual IELTS Speaking System, GenZify, and Parallel Universe Decision Simulator",
  "main": "electron/main.mjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "start": "node server.mjs",
    "postinstall": "npm run build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"cross-env WAIT_ON_DEV=true node electron/run-electron.mjs\"",
    "electron:build": "npm run build && electron-builder",
    "deploy:gh-pages": "node deploy-gh-pages.mjs"
  },
  "keywords": [
    "electron",
    "ielts",
    "genz",
    "decision-simulator",
    "parallel-universe",
    "visual-vocabulary"
  ],
  "author": "Antigravity AI",
  "license": "MIT",
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
